# Postgres with PostGIS. Neon works and is what the deployed build uses:
# DATABASE_URL is the pooled (-pooler) host the app runs on, DIRECT_URL the
# same host without -pooler, because migrations take advisory locks a pooler
# cannot hold. Run `CREATE EXTENSION postgis;` once on a fresh database.
# Local docker-compose alternative:
#   postgresql://vora:vora@localhost:5436/vora?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/vora_db?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/vora_db?sslmode=require"
JWT_SECRET="dev-secret-change-me"
MAPBOX_SECRET=""
# Comma-separated origins allowed to call the API. Leave blank to allow any
# (fine locally; set it to the deployed web URL in production).
CORS_ORIGINS=""
# Campay MoMo collection. Leave the key/secret blank to fall back to a
# simulated MoMo rail (charge settles after a few seconds) so payments stay
# demoable without sandbox credentials. Sandbox: https://demo.campay.net
CAMPAY_API_KEY=""
CAMPAY_API_SECRET=""
CAMPAY_BASE_URL="https://demo.campay.net"
FAPSHI_API_USER=""
FAPSHI_API_KEY=""
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
PORT=4000
